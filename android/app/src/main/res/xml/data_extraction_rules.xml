<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила извлечения данных для Android 12+ (API 31+)
   Контролирует, какие данные могут быть извлечены из приложения
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="user_session.xml"/>
        <exclude domain="sharedpref" path="auth_tokens.xml"/>
        <exclude domain="database" path="user_data.db"/>
        <exclude domain="file" path="cache/"/>
        <exclude domain="file" path="temp/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="user_session.xml"/>
        <exclude domain="sharedpref" path="auth_tokens.xml"/>
        <exclude domain="database" path="user_data.db"/>
    </device-transfer>
</data-extraction-rules>